# Non-secret machine-local variables.
# Copy to local/machine.env and customize.

DOTFILES_DEVELOPER_ROOT="$HOME/Developer"
DOTFILES_HOMEBREW_PREFIX="/opt/homebrew"
DOTFILES_FILES_ROOT="$HOME/Files"
DOTFILES_OBSIDIAN_VAULT_PATH="$DOTFILES_FILES_ROOT"
DOTFILES_LMSTUDIO_HOME="$HOME/.lmstudio"
DOTFILES_EDITOR="code --wait"
DOTFILES_SCREENSHOTS_PATH="$DOTFILES_FILES_ROOT/00 Inbox/Screenshots"
