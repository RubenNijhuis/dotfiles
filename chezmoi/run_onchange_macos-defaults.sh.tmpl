#!/usr/bin/env bash
# Remaining macOS preferences that nix-darwin cannot model cleanly. Most
# defaults now belong to nix/darwin/defaults.nix; keep this script narrow so
# chezmoi never competes with Nix for the same preference.
#
# To force a re-run without editing:
#   chezmoi state delete-bucket --bucket scriptState && chezmoi apply
# Or just invoke this file directly:
#   bash <repo>/chezmoi/run_onchange_macos-defaults.sh.tmpl  # (after chezmoi renders it)
#
# Migrated from setup/macos-defaults.sh.

set -euo pipefail

DOTFILES_ROOT="{{ joinPath .chezmoi.sourceDir ".." }}"
echo "Applying macOS settings outside nix-darwin..."

# Close System Preferences to prevent overrides.
osascript -e 'tell application "System Preferences" to quit' 2>/dev/null || true

# Dock item placement has no stable nix-darwin representation. It is opt-in:
# without a local list, this script deliberately leaves the current Dock alone.
if command -v dockutil >/dev/null 2>&1 && [[ -f "$DOTFILES_ROOT/local/dock-apps.txt" ]]; then
  dockutil --no-restart --remove all

  dock_apps=()
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -n "$line" ]] && dock_apps+=("$line")
  done < "$DOTFILES_ROOT/local/dock-apps.txt"

  for app_path in "${dock_apps[@]}"; do
    [[ -e "$app_path" ]] && dockutil --no-restart --add "$app_path"
  done

  if [[ -d "$HOME/Downloads" ]]; then
    dockutil --no-restart --add "$HOME/Downloads" --view grid --display stack --sort dateadded --section others
  fi
fi

# Keep the Library visible; this is a filesystem flag, not a defaults value.
chflags nohidden "$HOME/Library" 2>/dev/null || true

# Refresh the two applications affected by this script.
for app in "Finder" "Dock" "SystemUIServer"; do
  killall "$app" &>/dev/null || true
done

echo "macOS settings outside nix-darwin applied."
