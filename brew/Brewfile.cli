# =============================================================================
# Homebrew CLI exceptions
# =============================================================================
# Nix owns portable terminal tooling. Keep only macOS-specific or unreplaced
# exceptions here. VS Code extensions are declared directly through Nix.

# -----------------------------------------------------------------------------
# Taps
# -----------------------------------------------------------------------------
tap "krishkrosh/apps"
tap "spicetify/homebrew-tap"
tap "steipete/tap"
tap "yakitrak/yakitrak"

# -----------------------------------------------------------------------------
# Shell and terminal exceptions
# -----------------------------------------------------------------------------
brew "gum"                       # Interactive terminal UI components
brew "ghq"                       # Git repository manager for local checkouts

# -----------------------------------------------------------------------------
# CLI exceptions
# -----------------------------------------------------------------------------
brew "grc"           # Colorize command output
brew "tree"          # Directory tree visualization
brew "parallel"      # GNU parallel for concurrent job execution
brew "git-cliff"     # Conventional-commits changelog generator
# gh-dash: install via `gh extension install dlvhdr/gh-dash` (not in core).

# -----------------------------------------------------------------------------
# Development exceptions
# -----------------------------------------------------------------------------
brew "shellharden"   # Shell script hardening linter
brew "tealdeer"      # Fast tldr client for quick command examples

# Language runtimes, mise, and formatters are not part of the global bootstrap.
# Use Nix capabilities and project devShells. Existing local mise state remains
# untouched until its active Ruby shim has been retired deliberately.

# -----------------------------------------------------------------------------
# Security & Privacy
# -----------------------------------------------------------------------------
brew "gnupg"         # GPG encryption
brew "pinentry-mac"  # GPG passphrase entry for macOS
brew "qrencode"      # QR code generator

# -----------------------------------------------------------------------------
# System Utilities
# -----------------------------------------------------------------------------
brew "dive"                  # Docker image layer explorer
brew "dockutil"             # Manage Dock items declaratively
brew "obsidian-cli"         # Obsidian CLI tools
brew "git-flow"
