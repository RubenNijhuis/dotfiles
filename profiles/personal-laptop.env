DOTFILES_PROFILE="personal-laptop"
DOTFILES_PROFILE_LABEL="Personal Laptop"
# GUI applications are no longer a single laptop baseline. The legacy
# Brewfile.apps is retained as an inventory while capabilities move to Nix and
# platform-specific opt-in catalogs. This does not uninstall existing apps.
DOTFILES_PROFILE_BREWFILES="Brewfile.cli"
DOTFILES_PROFILE_AUTOMATIONS="dotfiles-backup dotfiles-doctor repo-update log-cleanup brew-audit weekly-digest obsidian-sync lmstudio-server"
