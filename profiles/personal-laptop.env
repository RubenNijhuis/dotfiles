DOTFILES_PROFILE="personal-laptop"
DOTFILES_PROFILE_LABEL="Personal Laptop"
# Nix supplies this laptop's portable tools and desktop applications. Prism is
# the one retained Mac gaming exception; design, media, and service casks stay
# opt-in on a per-machine basis.
DOTFILES_PROFILE_BREWFILES="gaming"
# Specialist services such as a future WebDAV vault endpoint and LM Studio stay opt-in.
# Their local data is not present on this laptop, so they do not belong in the
# default automation set.
DOTFILES_PROFILE_AUTOMATIONS="dotfiles-backup dotfiles-doctor repo-update log-cleanup weekly-digest"
