DOTFILES_PROFILE="personal-laptop"
DOTFILES_PROFILE_LABEL="Personal Laptop"
# Nix supplies portable CLI tooling. Homebrew only bootstraps the remaining
# transition tools and this small everyday macOS GUI core. Brewfile.apps stays
# a historical inventory; it is deliberately not installed by default.
DOTFILES_PROFILE_BREWFILES="Brewfile.bootstrap Brewfile.core"
# Specialist services such as Obsidian Git sync and LM Studio stay opt-in.
# Their local data is not present on this laptop, so they do not belong in the
# default automation set.
DOTFILES_PROFILE_AUTOMATIONS="dotfiles-backup dotfiles-doctor repo-update log-cleanup brew-audit weekly-digest"
