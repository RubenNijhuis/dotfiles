DOTFILES_PROFILE="personal-laptop"
DOTFILES_PROFILE_LABEL="Personal Laptop"
# Nix supplies this laptop's portable tools and desktop applications. Prism is
# a retained Mac gaming exception. Mac pinentry stays on its newer Homebrew
# version; design, media, and service casks stay opt-in on a per-machine basis.
DOTFILES_PROFILE_BREWFILES="Brewfile.gaming Brewfile.security"
# Only the already-used update report is selected by default. Backups, repo
# writes, cleanup, digests, and specialist services remain explicit opt-ins.
DOTFILES_PROFILE_AUTOMATIONS="update-audit"
